# Ensure a strong hash function.
startup --host_jvm_args=-Dbazel.DigestFunction=SHA256

# Start Python programs with the declared interpreter, without requiring a host
# Python interpreter to bootstrap it.
build --@rules_python//python/config_settings:bootstrap_impl=script

# Build C with GNU17 and C++ with C++17.
build --conlyopt=-std=gnu17 --cxxopt=-std=c++17
build --host_conlyopt=-std=gnu17 --host_cxxopt=-std=c++17

# Display the current git revision in the info block.
build --stamp --workspace_status_command tools/workspace_status.sh

build:race --@io_bazel_rules_go//go/config:race --@io_bazel_rules_go//go/config:pure=false
test:race --@io_bazel_rules_go//go/config:race --@io_bazel_rules_go//go/config:pure=false

# Build with the runtime lock-order checker (the "lockdep" go build tag).
build:lockdep --define=lockdep=true
test:lockdep --define=lockdep=true

build --@io_bazel_rules_go//go/config:pure
test --@io_bazel_rules_go//go/config:pure

# Set bazel_rule as non-pure when cgo is used.
build:plugin-tldk --@io_bazel_rules_go//go/config:pure=false --define=plugin_tldk=true --define=network_plugins=true

# By default, exclude nogo targets from building. They will still be included
# by default for all tests.
build --build_tag_filters=-nogo

# Select the ordinary syscall tests used by public CI.
build:syscalls-amd64 --test_tag_filters=-allsave,-runsc_slimvm
build:syscalls-arm64 --test_tag_filters=-allsave,runsc_ptrace,runsc_systrap

# Set flags for x86_64.
build:x86_64 --cpu=k8
build:x86_64 --platforms=//tools/bazeldefs:linux_amd64

# Set flags for aarch64.
build:aarch64 --cpu=aarch64
build:aarch64 --platforms=//tools/bazeldefs:linux_arm64

# BuildBuddy's hosted coordinator supplies this configuration and authentication.
# Both compilation and test actions execute remotely; the execution platform
# owns the runtime image so per-test properties retain its image and architecture.
build:rbe-common --config=buildbuddy_remote_executor
# Keep remote workers fed independently of the coordinator's CPU count.
build:rbe-common --jobs=400
# Uploads otherwise hold the action-preparation semaphore and delay new work.
# https://github.com/bazelbuild/bazel/issues/28734
build:rbe-common --noexperimental_throttle_remote_action_building
build:rbe-common --define=rbe=true
build:rbe-common --spawn_strategy=remote
build:rbe-common --noremote_local_fallback
build:rbe-common --remote_cache_compression
test:rbe-common --strategy=TestRunner=remote

# Keep compilation on RBE while a native Linux coordinator runs the tests.
# Local results describe that host, not the remote platform's runtime fixture.
test:rbe-local-tests --strategy=TestRunner=local
test:rbe-local-tests --local_test_jobs=1
test:rbe-local-tests --nocache_test_results
test:rbe-local-tests --flaky_test_attempts=1
build:rbe-local-tests --noremote_upload_local_results

# Native namespace frontends alone require local execution. Other tests keep
# the remote strategy; compilation has no local strategy or failure fallback.
build:rbe-hybrid-tests --config=rbe-local-tests
test:rbe-hybrid-tests --strategy=TestRunner=remote,local
test:rbe-hybrid-tests --local_test_jobs=2

build:rbe --config=rbe-common
# Architecture-specific generators may need the other native CPU even when
# the requested build or test lane selects only one target architecture.
build:rbe --extra_execution_platforms=//tools/bazeldefs:rbe_linux_amd64,//tools/bazeldefs:rbe_linux_arm64
build:rbe --host_platform=//tools/bazeldefs:rbe_linux_amd64

# Prefer native ARM64 tools and workers, including host-configured test actions.
build:rbe-arm64 --config=rbe-common
build:rbe-arm64 --extra_execution_platforms=//tools/bazeldefs:rbe_linux_arm64,//tools/bazeldefs:rbe_linux_amd64
build:rbe-arm64 --host_platform=//tools/bazeldefs:rbe_linux_arm64

# Use prebuilt protoc to speed up builds.
common --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc
common --incompatible_enable_proto_toolchain_resolution=true

# One graph can compile and execute explicit AMD64 and ARM64 test variants.
# Target-owned execution constraints select the worker without a host-platform
# override; test.* properties continue to select isolated runtime fixtures.
build:rbe-matrix --config=rbe-common
build:rbe-matrix --extra_execution_platforms=//tools/bazeldefs:rbe_linux_amd64,//tools/bazeldefs:rbe_linux_arm64
