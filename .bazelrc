# Ensure a strong hash function.
startup --host_jvm_args=-Dbazel.DigestFunction=SHA256

# Start Python programs with the declared interpreter, without requiring a host
# Python interpreter to bootstrap it.
build --@rules_python//python/config_settings:bootstrap_impl=script

# Build C with GNU17 and C++ with C++17.
build --conlyopt=-std=gnu17 --cxxopt=-std=c++17
build --host_conlyopt=-std=gnu17 --host_cxxopt=-std=c++17

# Libraries such as GoogleTest export third-party headers through cc_library's
# includes attribute. Treat those directories as system headers so that a
# warning in an included dependency does not fail a gVisor build under -Werror.
build --features=system_include_paths --host_features=system_include_paths

# Display the current git revision in the info block.
build --stamp --workspace_status_command tools/workspace_status.sh

build:race --@io_bazel_rules_go//go/config:race --@io_bazel_rules_go//go/config:pure=false
test:race --@io_bazel_rules_go//go/config:race --@io_bazel_rules_go//go/config:pure=false

# Build with the runtime lock-order checker (the "lockdep" go build tag).
build:lockdep --define=lockdep=true
test:lockdep --define=lockdep=true

build --@io_bazel_rules_go//go/config:pure
test --@io_bazel_rules_go//go/config:pure

# Set bazel_rule as non-pure when cgo is used.
build:plugin-tldk --@io_bazel_rules_go//go/config:pure=false --define=plugin_tldk=true --define=network_plugins=true

# By default, exclude nogo targets from building. They will still be included
# by default for all tests.
build --build_tag_filters=-nogo

# Select the ordinary syscall tests used by public CI.
test:syscalls-amd64 --test_tag_filters=-allsave,-runsc_slimvm
test:syscalls-arm64 --test_tag_filters=-allsave,runsc_ptrace,runsc_systrap
build:syscalls-arm64-64k --test_tag_filters=-allsave,runsc_systrap
build:syscalls-arm64-64k --//tools/bazeldefs:page_size=64k

# Set flags for x86_64.
build:x86_64 --cpu=k8
build:x86_64 --platforms=//tools/bazeldefs:linux_amd64

# Set flags for aarch64.
build:aarch64 --cpu=aarch64
build:aarch64 --platforms=//tools/bazeldefs:linux_arm64

# Use prebuilt protoc to speed up builds.
common --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc
common --incompatible_enable_proto_toolchain_resolution=true

# The worker scheduler uses each action's selected execution platform. The
# service endpoint and credentials come from the coordinator's Bazel rc.
build:source-presubmit-common --define=source_presubmit=true
build:source-presubmit-common --spawn_strategy=remote --noremote_local_fallback
build:source-presubmit-common --strip=never --test_env=CGROUPV2=true
test:source-presubmit-common --strategy=TestRunner=remote
test:source-presubmit-common --test_tag_filters=-nogo,-requires-kvm --build_tag_filters=-network_plugins
test:source-presubmit-common --target_pattern_file=test/rbe/source-presubmit.targets

# The architecture split builds tools for the same platform. Giving the
# worker a second platform label makes Bazel configure LLVM's runtime twice
# for one set of object paths.
build:source-presubmit --config=source-presubmit-common
build:source-presubmit --config=x86_64
build:source-presubmit --extra_execution_platforms=//test/rbe:ubuntu_amd64

build:source-presubmit-arm64 --config=source-presubmit-common
build:source-presubmit-arm64 --config=aarch64
# Bazel can select its host platform for the seccomp generator. Build the
# generator for the ARM worker even when the Bazel client runs on x86_64.
build:source-presubmit-arm64 --host_platform=//tools/bazeldefs:linux_arm64
build:source-presubmit-arm64 --extra_execution_platforms=//test/rbe:ubuntu_arm64

# Run each architecture's tests on a worker that matches its test executable.
build:source-presubmit-mixed --config=source-presubmit-common
build:source-presubmit-mixed --config=x86_64
build:source-presubmit-mixed --host_platform=//tools/bazeldefs:linux_amd64
build:source-presubmit-mixed --extra_execution_platforms=//test/rbe:ubuntu_amd64,//test/rbe:ubuntu_arm64
test:source-presubmit-mixed --target_pattern_file=test/rbe/mixed-native.targets
