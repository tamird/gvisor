# DPDK uses glibc's port-I/O delay helpers, which musl does not provide.
# Use the undelayed forms on musl, as in the upstream correction:
# https://github.com/DPDK/dpdk/commit/204a7f44bc457b2c75c9eeb56468214664c830f0

diff --git a/drivers/bus/pci/linux/pci_uio.c b/drivers/bus/pci/linux/pci_uio.c
--- a/drivers/bus/pci/linux/pci_uio.c
+++ b/drivers/bus/pci/linux/pci_uio.c
@@ -14,6 +14,11 @@
 
 #if defined(RTE_ARCH_X86)
 #include <sys/io.h>
+#ifndef __GLIBC__
+#define outb_p outb
+#define outw_p outw
+#define outl_p outl
+#endif
 #endif
 
 #include <rte_log.h>

# Use the POSIX positioned-I/O API for VFIO with modern musl. The plugin's
# x86_64 target has 64-bit off_t with both musl and glibc.
# https://github.com/DPDK/dpdk/commit/c41a103c9
# https://github.com/DPDK/dpdk/commit/884f83ccf

