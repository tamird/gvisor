@@ -0,0 +1,24 @@
+"""Compile the Go SDK bootstrap helpers with a private cache."""
+
+import os
+import subprocess
+import sys
+import tempfile
+
+
+def main():
+    pack, builder, *sources = sys.argv[1:]
+    with tempfile.TemporaryDirectory(dir=os.getcwd()) as cache:
+        env = os.environ | {
+            "HOME": cache,
+            "TMPDIR": cache,
+            "PATH": "/nonexistent",
+            "CGO_ENABLED": "0",
+        }
+        args = [env["GO_BINARY"], "build", "-trimpath", '-ldflags=-buildid="" ' + env["LD_FLAGS"], "-o"]
+        subprocess.run([*args, pack, "cmd/pack"], env=env, check=True)
+        subprocess.run([*args, builder, *sources], env=env, check=True)
+
+
+if __name__ == "__main__":
+    main()
