Expose a header-only CcInfo target for BPF compilation. Depending on
:bpf also analyzes :libbpf_impl and fetches elfutils and zlib, even when
a consumer reads only CcInfo.compilation_context. Keep those
implementation dependencies on :bpf so userspace library consumers
retain them.

--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -83,9 +83,8 @@
 )
 
 cc_library(
-    name = "bpf",
+    name = "bpf_headers",
     hdrs = _PUBLIC_HEADERS,
-    implementation_deps = [":libbpf_impl"],
     include_prefix = "bpf",
     strip_include_prefix = "src",
     visibility = ["//visibility:public"],
@@ -94,6 +93,13 @@
     ],
 )
 
+cc_library(
+    name = "bpf",
+    implementation_deps = [":libbpf_impl"],
+    visibility = ["//visibility:public"],
+    deps = [":bpf_headers"],
+)
+
 alias(
     name = "libbpf",
     actual = ":bpf",
