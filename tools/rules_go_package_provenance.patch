+// jsonManifest supplies the outputs of a completed, explicitly selected Bazel
+// analysis. It is not a query cache: this mode handles only its exact root set.
+type jsonManifest struct {
+	JSONFiles    []string
+	Labels       []string
+	BazelVersion string
+	Workspace    string
+	ExecRoot     string
+	OutputBase   string
+	Arch         string
+	Tests        bool
+}
+
+func runJSONManifest(path string, request *packages.DriverRequest, queries []string, out io.Writer) error {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	var manifest jsonManifest
+	if err := json.Unmarshal(data, &manifest); err != nil {
+		return err
+	}
+	if !slices.Equal(queries, manifest.Labels) || request.Tests != manifest.Tests || len(queries) == 0 {
+		return fmt.Errorf("request differs from declared JSON package roots or test mode")
+	}
+	version, ok := parseBazelVersion(manifest.BazelVersion)
+	if !ok {
+		return fmt.Errorf("invalid manifest Bazel version %q", manifest.BazelVersion)
+	}
+	for _, root := range []string{manifest.Workspace, manifest.ExecRoot, manifest.OutputBase} {
+		if !filepath.IsAbs(root) {
+			return fmt.Errorf("manifest path is not absolute: %q", root)
+		}
+	}
+	if manifest.Arch == "" || len(manifest.JSONFiles) == 0 {
+		return fmt.Errorf("manifest lacks architecture or package JSON")
+	}
+	replacer := strings.NewReplacer(
+		"__BAZEL_WORKSPACE__", manifest.Workspace,
+		"__BAZEL_EXECROOT__", manifest.ExecRoot,
+		"__BAZEL_OUTPUT_BASE__", manifest.OutputBase,
+	)
+	driver, err := NewJSONPackagesDriver(manifest.JSONFiles, replacer.Replace, version, request.Overlay)
+	if err != nil {
+		return err
+	}
+	response := driver.GetResponse(manifest.Labels)
+	response.Compiler = "gc"
+	response.Arch = manifest.Arch
+	for _, label := range manifest.Labels {
+		if !slices.Contains(response.Roots, label) {
+			return fmt.Errorf("declared root missing from package metadata: %s", label)
+		}
+	}
+	return json.NewEncoder(out).Encode(response)
+}
+
 func main() {
 	ctx, cancel := signalContext(context.Background(), os.Interrupt)
 	defer cancel()
