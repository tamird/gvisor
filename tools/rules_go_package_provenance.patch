+// jsonManifest supplies the outputs of a completed, explicitly selected Bazel
+// analysis. Each call may request a subset of its declared roots because
+// packages.Load partitions long requests before invoking the external driver:
+// https://github.com/golang/tools/blob/ea2f152dc/go/packages/packages.go#L297-L318
+type jsonManifest struct {
+	JSONFiles    []string
+	Labels       []string
+	BazelVersion string
+	Workspace    string
+	ExecRoot     string
+	OutputBase   string
+	Arch         string
+	Tests        bool
+}
+
+func runJSONManifest(path string, request *packages.DriverRequest, queries []string, out io.Writer) error {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	var manifest jsonManifest
+	if err := json.Unmarshal(data, &manifest); err != nil {
+		return err
+	}
+	if request.Tests != manifest.Tests || len(queries) == 0 {
+		return fmt.Errorf("request differs from declared JSON package test mode or has no roots")
+	}
+	allowed := make(map[string]bool, len(manifest.Labels))
+	for _, label := range manifest.Labels {
+		if label == "" || allowed[label] {
+			return fmt.Errorf("empty or duplicate declared package root: %q", label)
+		}
+		allowed[label] = true
+	}
+	requested := make(map[string]bool, len(queries))
+	for _, label := range queries {
+		if !allowed[label] || requested[label] {
+			return fmt.Errorf("undeclared or duplicate requested package root: %q", label)
+		}
+		requested[label] = true
+	}
+	version, ok := parseBazelVersion(manifest.BazelVersion)
+	if !ok {
+		return fmt.Errorf("invalid manifest Bazel version %q", manifest.BazelVersion)
+	}
+	for _, root := range []string{manifest.Workspace, manifest.ExecRoot, manifest.OutputBase} {
+		if !filepath.IsAbs(root) {
+			return fmt.Errorf("manifest path is not absolute: %q", root)
+		}
+	}
+	if manifest.Arch == "" || len(manifest.JSONFiles) == 0 {
+		return fmt.Errorf("manifest lacks architecture or package JSON")
+	}
+	replacer := strings.NewReplacer(
+		"__BAZEL_WORKSPACE__", manifest.Workspace,
+		"__BAZEL_EXECROOT__", manifest.ExecRoot,
+		"__BAZEL_OUTPUT_BASE__", manifest.OutputBase,
+	)
+	driver, err := NewJSONPackagesDriver(manifest.JSONFiles, replacer.Replace, version, request.Overlay)
+	if err != nil {
+		return err
+	}
+	response := driver.GetResponse(queries)
+	response.Compiler = "gc"
+	response.Arch = manifest.Arch
+	if len(response.Roots) != len(requested) {
+		return fmt.Errorf("package metadata returned %d roots for %d requested roots", len(response.Roots), len(requested))
+	}
+	for _, label := range response.Roots {
+		if !requested[label] {
+			return fmt.Errorf("unexpected or duplicate package metadata root: %q", label)
+		}
+		delete(requested, label)
+	}
+	return json.NewEncoder(out).Encode(response)
+}
