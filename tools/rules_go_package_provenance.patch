+func TestJSONManifestSourceFiltering(t *testing.T) {
+	t.Setenv("GOTAGS", "")
+	previous := buildContext
+	buildContext = makeBuildContext()
+	defer func() { buildContext = previous }()
+	for _, tc := range []struct {
+		name, filename, source         string
+		missing, wantError, wantSource bool
+	}{
+		{name: "default fallback", filename: "fallback.go", source: "//go:build !custom\n\npackage p\n", wantSource: true},
+		{name: "tag excluded", filename: "tagged.go", source: "//go:build custom\n\npackage p\n"},
+		{name: "invalid constraint", filename: "invalid.go", source: "//go:build (\n\npackage p\n", wantError: true},
+		{name: "missing source", filename: "missing.go", missing: true, wantError: true},
+		{name: "cgo generated", filename: "_cgo_gotypes.go", source: "package p\n", wantSource: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, tc.filename)
+			if !tc.missing {
+				if err := os.WriteFile(path, []byte(tc.source), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			const label = "@@//example:p"
+			record := FlatPackage{ID: label, Name: "p", PkgPath: "example/p", Dir: dir, GoFiles: []string{path}, CompiledGoFiles: []string{path}}
+			data, err := json.Marshal(record)
+			if err != nil {
+				t.Fatal(err)
+			}
+			metadata := filepath.Join(dir, "package.json")
+			if err := os.WriteFile(metadata, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			manifest := jsonManifest{JSONFiles: []string{metadata}, Labels: []string{label}, BazelVersion: "8.8.1", Workspace: dir, ExecRoot: dir, OutputBase: dir, Arch: "amd64"}
+			data, err = json.Marshal(manifest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			manifestPath := filepath.Join(dir, "manifest.json")
+			if err := os.WriteFile(manifestPath, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			var output bytes.Buffer
+			err = runJSONManifest(manifestPath, &packages.DriverRequest{}, []string{label}, &output)
+			if tc.wantError {
+				if err == nil || output.Len() != 0 {
+					t.Fatalf("invalid source returned error %v and output %q", err, output.String())
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			var response packages.DriverResponse
+			if err := json.Unmarshal(output.Bytes(), &response); err != nil {
+				t.Fatal(err)
+			}
+			if len(response.Roots) != 1 || response.Roots[0] != label || len(response.Packages) != 1 {
+				t.Fatalf("unexpected response: %+v", response)
+			}
+			files := response.Packages[0].CompiledGoFiles
+			if tc.wantSource && !slices.Equal(files, []string{path}) || !tc.wantSource && len(files) != 0 {
+				t.Fatalf("filtered files %v, want source %v", files, tc.wantSource)
+			}
+		})
+	}
+}
