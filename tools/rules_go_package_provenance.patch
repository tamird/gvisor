+func TestJSONManifestRequests(t *testing.T) {
+	const a, b, missing = "@@//example:a", "@@//example:b", "@@//example:missing"
+	for _, tc := range []struct {
+		name      string
+		queries   []string
+		labels    []string
+		tests     bool
+		xTest     bool
+		wantError bool
+	}{
+		{name: "first batch", queries: []string{a}},
+		{name: "last batch", queries: []string{b}},
+		{name: "full request", queries: []string{a, b}},
+		{name: "reordered request", queries: []string{b, a}},
+		{name: "empty request", wantError: true},
+		{name: "unknown root", queries: []string{missing}, wantError: true},
+		{name: "duplicate request", queries: []string{a, a}, wantError: true},
+		{name: "test mode", queries: []string{a}, tests: true, wantError: true},
+		{name: "missing metadata", queries: []string{missing}, labels: []string{a, b, missing}, wantError: true},
+		{name: "unexpected xtest", queries: []string{a}, xTest: true, wantError: true},
+		{name: "duplicate manifest", queries: []string{a}, labels: []string{a, a}, wantError: true},
+		{name: "empty manifest root", queries: []string{a}, labels: []string{a, ""}, wantError: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			jsonPath := filepath.Join(dir, "packages.json")
+			var metadata bytes.Buffer
+			encoder := json.NewEncoder(&metadata)
+			records := []FlatPackage{
+				{ID: a, Name: "a", PkgPath: "example/a"},
+				{ID: b, Name: "b", PkgPath: "example/b"},
+			}
+			if tc.xTest {
+				records = append(records, FlatPackage{ID: a + "_xtest", Name: "a_test", PkgPath: "example/a_test"})
+			}
+			for _, record := range records {
+				if err := encoder.Encode(record); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := os.WriteFile(jsonPath, metadata.Bytes(), 0600); err != nil {
+				t.Fatal(err)
+			}
+			labels := tc.labels
+			if labels == nil {
+				labels = []string{a, b}
+			}
+			manifest := jsonManifest{
+				JSONFiles: []string{jsonPath}, Labels: labels, BazelVersion: "8.8.1",
+				Workspace: dir, ExecRoot: dir, OutputBase: dir, Arch: "amd64",
+			}
+			data, err := json.Marshal(manifest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			manifestPath := filepath.Join(dir, "manifest.json")
+			if err := os.WriteFile(manifestPath, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			var output bytes.Buffer
+			err = runJSONManifest(manifestPath, &packages.DriverRequest{Tests: tc.tests}, tc.queries, &output)
+			if tc.wantError {
+				if err == nil || output.Len() != 0 {
+					t.Fatalf("invalid request returned error %v and output %q", err, output.String())
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			var response packages.DriverResponse
+			if err := json.Unmarshal(output.Bytes(), &response); err != nil {
+				t.Fatal(err)
+			}
+			want := slices.Clone(tc.queries)
+			slices.Sort(want)
+			slices.Sort(response.Roots)
+			if !slices.Equal(response.Roots, want) || len(response.Packages) != len(want) {
+				t.Fatalf("response roots %v, packages %d; want only %v", response.Roots, len(response.Packages), want)
+			}
+			if response.NotHandled || response.Compiler != "gc" || response.Arch != "amd64" {
+				t.Fatalf("unexpected driver contract: %+v", response)
+			}
+		})
+	}
+}
