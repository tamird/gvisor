+    ctx.actions.run(
+        executable = tc._builder,
+        arguments = [args] + arguments,
+        outputs = outputs + ([stdout] if stdout else []),
+        tools = [executable, tc._go_on_path, sdk_files] + ([tools] if type(tools) == "depset" else tools),
+        toolchain = GO_TOOLCHAIN_LABEL,
+        **kwargs
+    )
