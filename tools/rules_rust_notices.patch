Expose the std notice bundle already extracted from the pinned compiler.
This lets images retain the release attribution without another download
or a checked-in copy of its generated HTML.

Select Rust's declared linker only for self-contained musl toolchains.
A platform-wide preference also reaches GNU execution helpers, whose
system libraries must be resolved through the selected C/C++ toolchain.
Use the existing per-toolchain attribute so GNU keeps its normal choice.

--- a/rust/private/repository_utils.bzl
+++ b/rust/private/repository_utils.bzl
@@ -44,6 +44,8 @@
 )
 
 _build_file_for_compiler_template = """\
+exports_files(["share/doc/rust/COPYRIGHT-library.html"])
+
 filegroup(
     name = "rustc",
     srcs = ["bin/rustc{binary_ext}"],
@@ -345,6 +347,7 @@
     rustc = "//:rustc",
     linker = {linker_label},
     linker_type = {linker_type},
+    linker_preference = {linker_preference},
     rust_objcopy = {rust_objcopy_label},
     rustfmt = {rustfmt_label},
     cargo = "//:cargo",
@@ -476,6 +479,7 @@
         llvm_lib_label = repr(llvm_lib_label),
         linker_label = repr(linker_label),
         linker_type = repr(linker_type),
+        linker_preference = repr("rust" if include_linker and target_triple.abi == "musl" else None),
         rust_objcopy_label = repr(rust_objcopy_label),
         extra_rustc_flags = extra_rustc_flags,
         extra_exec_rustc_flags = extra_exec_rustc_flags,
