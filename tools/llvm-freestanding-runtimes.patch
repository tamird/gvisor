Respect the freestanding C++ runtime opt-out on Linux.

Backport only the three production hunks from:
https://github.com/hermeticbuild/hermetic-llvm/commit/ddd134580f7e2cb556c4ee3c7e2a0cc1ab696a11

The pinned 0.8.24 file omits the newer, unrelated glibc header macros.
Keep that release behavior and omit the Git-only supplier e2e test.

diff --git a/toolchain/args/linux/BUILD.bazel b/toolchain/args/linux/BUILD.bazel
--- a/toolchain/args/linux/BUILD.bazel
+++ b/toolchain/args/linux/BUILD.bazel
@@ -1,4 +1,5 @@
 load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
+load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")
 
 package(default_visibility = ["//visibility:public"])
 
@@ -96,31 +97,41 @@
     },
 )
 
+# Explicit linkopts such as -lc still need the libc search path when the
+# target disables the C++ runtimes. This applies to both glibc and musl.
 cc_args(
-    name = "default_libs_gnu",
-    actions = [
-        "@rules_cc//cc/toolchains/actions:link_actions",
-    ],
+    name = "glibc_library_search_path",
+    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
+    args = ["-L{libc_library_search_path}"],
+    data = ["//runtimes/glibc:glibc_library_search_directory"],
+    format = {"libc_library_search_path": "//runtimes/glibc:glibc_library_search_directory"},
+)
+
+# libunwind needs pthread and dl. A target that opts out of the toolchain's
+# C++ runtimes does not link libunwind or need its dependencies.
+cc_args(
+    name = "libunwind_system_libraries",
+    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
     args = [
-        # We need to support copts like -lc -ldl etc...
-        "-L{libc_library_search_path}",
-
-        # In prevention of when all of those can be shared libraries.
         "-Wl,--push-state",
         "-Wl,--as-needed",
-
-        # Since libunwind is linked statically, we need to link pthread as well.
         "-lpthread",
-        # Since libunwind is linked statically, we need to link dl as well.
         "-ldl",
         "-Wl,--pop-state",
     ],
-    data = [
-        "//runtimes/glibc:glibc_library_search_directory",
+    # The runtime bootstrap toolchains do not define this feature.
+    requires_any_of = select({
+        "//toolchain:runtimes_all": ["//toolchain/features:static_link_cpp_runtimes"],
+        "//conditions:default": [],
+    }),
+)
+
+cc_args_list(
+    name = "default_libs_gnu",
+    args = [
+        ":glibc_library_search_path",
+        ":libunwind_system_libraries",
     ],
-    format = {
-        "libc_library_search_path": "//runtimes/glibc:glibc_library_search_directory",
-    },
 )
 
 ###
@@ -142,32 +153,20 @@
     },
 )
 
-#TODO: Factorize this and gnu
 cc_args(
+    name = "musl_library_search_path",
+    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
+    args = ["-L{libc_library_search_path}"],
+    data = ["//runtimes/musl:musl_library_search_directory"],
+    format = {"libc_library_search_path": "//runtimes/musl:musl_library_search_directory"},
+)
+
+cc_args_list(
     name = "default_libs_musl",
-    actions = [
-        "@rules_cc//cc/toolchains/actions:link_actions",
+    args = [
+        ":musl_library_search_path",
+        ":libunwind_system_libraries",
     ],
-    args = [
-        # We need to support copts like -lc -ldl etc...
-        "-L{libc_library_search_path}",
-
-        # In prevention of when all of those can be shared libraries.
-        "-Wl,--push-state",
-        "-Wl,--as-needed",
-
-        # Since libunwind is linked statically, we need to link pthread as well.
-        "-lpthread",
-        # Since libunwind is linked statically, we need to link dl as well.
-        "-ldl",
-        "-Wl,--pop-state",
-    ],
-    data = [
-        "//runtimes/musl:musl_library_search_directory",
-    ],
-    format = {
-        "libc_library_search_path": "//runtimes/musl:musl_library_search_directory",
-    },
     target_compatible_with = ["@platforms//os:linux"],
 )
 
