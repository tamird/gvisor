 # limitations under the License.
 """Internal utilities for rules_pkg."""
 
+load("@rules_python//python:py_info.bzl", "PyInfo")
 load("//pkg:providers.bzl", "PackageVariablesInfo")
+
+PACKAGE_RUNTIME = Label("//pkg/private:execution_runtime")
+
+def run_package_writer(ctx, writer, module, inputs, arguments, **kwargs):
+    """Run an internal rules_pkg writer with the selected execution runtime.
+
+    Args:
+      ctx: Rule context.
+      writer: The original executable target.
+      module: Its Python module under the rules_pkg repository root.
+      inputs: Depset of packaging inputs.
+      arguments: Original arguments to the writer.
+      **kwargs: Other ctx.actions.run arguments for this packaging rule.
+    """
+    executable = writer[DefaultInfo].files_to_run
+    env = {
+        "LANG": "en_US.UTF-8",
+        "LC_CTYPE": "UTF-8",
+        "PYTHONIOENCODING": "UTF-8",
+        "PYTHONUTF8": "1",
+    }
+    toolchain = ctx.toolchains[PACKAGE_RUNTIME]
+    if toolchain:
+        # The py_binary launcher may need a system interpreter or a shell.
+        # Both in-repository writers import their modules from this root.
+        runtime = toolchain.py3_runtime
+        if not runtime or not runtime.interpreter:
+            fail("Packaging needs an in-build Python 3 runtime")
+        executable = runtime.interpreter
+        arguments = ["-B", "-S", "-m", module] + arguments
+        env["PYTHONPATH"] = writer.label.workspace_root or "."
+        inputs = depset(transitive = [inputs, runtime.files, writer[PyInfo].transitive_original_sources])
+
+    ctx.actions.run(
+        executable = executable,
+        arguments = arguments,
+        inputs = inputs,
+        env = env,
+        **kwargs
+    )
 
