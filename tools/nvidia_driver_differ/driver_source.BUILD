package(default_visibility = ["//visibility:public"])

exports_files(["COPYING"])

filegroup(
    name = "sources",
    srcs = glob([
        "kernel-open/common/inc/**",
        "kernel-open/nvidia-uvm/*.h",
        "src/common/sdk/nvidia/inc/**",
        "src/common/shared/inc/**",
        "src/nvidia/arch/nvalloc/unix/include/**",
    ]),
)
