+/* Qualification-only: bounded, main-thread completion milestones. */
+static void
+p64_milestone(struct iperf_test *test, const char *phase, int result)
+{
+    static unsigned int count;
+    struct timespec now;
+    char line[256];
+    int len;
+
+    if (test->num_streams != 64 || count >= 12)
+        return;
+    ++count;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+        return;
+    len = snprintf(line, sizeof(line),
+        "P64_MILESTONE %lld.%09ld %s rc=%d done=%d omit=%d sent=%llu received=%llu goal=%llu\n",
+        (long long)now.tv_sec, now.tv_nsec, phase, result, test->done, test->omitting,
+        (unsigned long long)test->bytes_sent, (unsigned long long)test->bytes_received,
+        (unsigned long long)test->settings->bytes);
+    if (len > 0 && (size_t)len < sizeof(line))
+        (void)write(STDERR_FILENO, line, len);
+}
 
