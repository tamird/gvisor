Coral exposes host C tools without declaring their bytes as action inputs.
Keep only actions that can use those tools out of remote execution and caching.
Remove this exception after the hermetic LLVM replacement declares and qualifies
the compiler, linker, sysroot and runtime-library input closure.

diff --git a/go/private/actions/compilepkg.bzl b/go/private/actions/compilepkg.bzl
--- a/go/private/actions/compilepkg.bzl
+++ b/go/private/actions/compilepkg.bzl
@@ -179,6 +179,10 @@
         inputs_transitive.append(cgo_inputs)
         inputs_transitive.append(go.cc_toolchain_files)
         env["CC"] = go.cgo_tools.c_compiler_path
+        if go.cgo_tools.c_compiler_path.startswith("/"):
+            # Host C tools are not declared action inputs.
+            execution_requirements = dict(execution_requirements)
+            execution_requirements["no-remote"] = "1"
         if cppopts:
             compile_args.add("-cppflags", quote_opts(cppopts))
         if copts:
