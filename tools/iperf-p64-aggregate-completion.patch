+/* Qualification-only main-thread counters; no per-stream diagnostic I/O. */
+static volatile sig_atomic_t p64_created, p64_cancel_started, p64_cancel_returned;
+static volatile sig_atomic_t p64_join_started, p64_join_returned, p64_timer_returned;
+static volatile sig_atomic_t p64_printed;
+static struct timespec p64_created_at, p64_goal_at;
+
+void
+iperf_p64_snapshot(struct iperf_test *test)
+{
+    struct timespec now;
+    char line[512];
+    int len;
+
+    if (test->role != 'c' || test->num_streams != 64 || p64_printed)
+        return;
+    p64_printed = 1;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+        return;
+    len = snprintf(line, sizeof(line),
+        "P64_SUMMARY now=%lld.%09ld created_at=%lld.%09ld goal_at=%lld.%09ld "
+        "created=%d timer_returned=%d cancel_started=%d cancel_returned=%d "
+        "join_started=%d join_returned=%d state=%d done=%d sent=%llu goal=%llu\n",
+        (long long)now.tv_sec, now.tv_nsec,
+        (long long)p64_created_at.tv_sec, p64_created_at.tv_nsec,
+        (long long)p64_goal_at.tv_sec, p64_goal_at.tv_nsec,
+        p64_created, p64_timer_returned, p64_cancel_started, p64_cancel_returned,
+        p64_join_started, p64_join_returned, test->state, test->done,
+        (unsigned long long)test->bytes_sent, (unsigned long long)test->settings->bytes);
+    if (len > 0 && (size_t)len < sizeof(line))
+        (void)write(STDERR_FILENO, line, len);
+}
 
