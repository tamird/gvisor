diff --git a/python/private/native_launcher.bzl b/python/private/native_launcher.bzl
new file mode 100644
--- /dev/null
+++ b/python/private/native_launcher.bzl
@@ -0,0 +1,32 @@
+"""Native launcher API for an in-build, directory-backed POSIX application.
+
+Load the finalizer through a configured target: Bazel 8 autoloads py_binary
+while loading foreign .bzl files, so importing it in py_executable would
+form a load cycle before any target could be configured.
+"""
+
+load("@hermetic_launcher//launcher:lib.bzl", "launcher")
+
+def _supported(ctx, runtime, venv, executable):
+    # Only four slots are needed; the released template holds 256 bytes each.
+    # Application-specific interpreter options belong to the existing adapter.
+    return (
+        runtime and runtime.interpreter and getattr(runtime, "supports_build_time_venv", False) and
+        not venv.recreate_venv_at_runtime and
+        ctx.toolchains[launcher.finalizer_toolchain_type] != None and
+        ctx.toolchains[launcher.template_toolchain_type] != None and
+        len(launcher.to_rlocation_path(runtime.interpreter)) <= 256 and
+        len(launcher.to_rlocation_path(executable) + ".bootstrap.py") <= 256
+    )
+
+def _create(ctx, runtime, output, adapter):
+    args, transformed = launcher.args_from_entrypoint(runtime.interpreter)
+    args.extend(["-I", "-S"])
+    launcher.append_runfile(file = adapter, embedded_args = args, transformed_args = transformed)
+    launcher.compile_stub(ctx = ctx, embedded_args = args, transformed_args = transformed, output_file = output)
+
+def _native_launcher_api_impl(ctx):
+    _ = ctx
+    return [platform_common.ToolchainInfo(supported = _supported, create = _create)]
+
+native_launcher_api = rule(implementation = _native_launcher_api_impl)
