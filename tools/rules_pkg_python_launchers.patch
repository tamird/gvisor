+# limitations under the License.
+"""Run the Python tools that write tar and Debian packages."""
+
+load("@rules_python//python:py_executable_info.bzl", "PyExecutableInfo")
+load("@rules_python//python:py_info.bzl", "PyInfo")
+load("@rules_python//python:py_runtime_info.bzl", "PyRuntimeInfo")
+
+def _writer_pythonpath(ctx, writer):
+    # PyInfo.imports contains runfiles paths. Translate imports from the
+    # writer's own repository to execpaths; let the normal launcher handle
+    # other repositories and their runfiles mappings.
+    repo = writer.label.workspace_name or ctx.workspace_name
+    root = writer.label.workspace_root or "."
+    roots = []
+    for path in writer[PyInfo].imports.to_list():
+        name, _, suffix = path.partition("/")
+        if name != repo:
+            return None
+        roots.append(root + "/" + suffix if suffix else root)
+    return ":".join(roots)
+
+def run_package_writer(ctx, writer, inputs, arguments, **kwargs):
+    """Run an internal writer with the interpreter selected for its py_binary.
+
+    Args:
+      ctx: The packaging rule's context.
+      writer: The writer py_binary in the execution configuration.
+      inputs: Depset of packaging inputs.
+      arguments: Original arguments to the writer.
+      **kwargs: Remaining arguments to ctx.actions.run.
+    """
+    executable = writer[DefaultInfo].files_to_run
+    env = {
+        "LANG": "en_US.UTF-8",
+        "LC_CTYPE": "UTF-8",
+        "PYTHONIOENCODING": "UTF-8",
+        "PYTHONUTF8": "1",
+    }
+
+    # The POSIX py_binary launcher can require /usr/bin/env and a shell even
+    # when the interpreter itself is a declared tool. These two writers have
+    # only stdlib and rules_pkg imports, all rooted in this repository.
+    # Preserve native Windows launchers, platform interpreters, and older
+    # rules_python configurations that cannot supply the original sources.
+    main = writer[PyExecutableInfo].main if PyExecutableInfo in writer else None
+    runtime = writer[PyRuntimeInfo] if PyRuntimeInfo in writer else None
+    sources = getattr(writer[PyInfo], "transitive_original_sources", None) if PyInfo in writer else None
+    if executable.executable.extension != "exe" and main and runtime and runtime.interpreter and sources != None:
+        pythonpath = _writer_pythonpath(ctx, writer)
+        if pythonpath:
+            executable = runtime.interpreter
+            inputs = depset([main], transitive = [inputs, sources, runtime.files])
+            env["PYTHONPATH"] = pythonpath
+            arguments = ["-B", "-S", main.path] + arguments
+
+    ctx.actions.run(
+        executable = executable,
+        inputs = inputs,
+        arguments = arguments,
+        env = env,
+        **kwargs
+    )
