diff --git a/bazel/private/oss/toolchains/prebuilt/check_protoc_version.py b/bazel/private/oss/toolchains/prebuilt/check_protoc_version.py
new file mode 100644
--- /dev/null
+++ b/bazel/private/oss/toolchains/prebuilt/check_protoc_version.py
@@ -0,0 +1,45 @@
+# Protocol Buffers - Google's data interchange format
+# Copyright 2026 Google LLC.  All rights reserved.
+#
+# Use of this source code is governed by a BSD-style
+# license that can be found in the LICENSE file or at
+# https://developers.google.com/open-source/licenses/bsd
+
+"""Check the version reported by the selected protoc toolchain."""
+
+from pathlib import Path
+import subprocess
+import sys
+
+
+def main():
+    compiler, output, expected, severity = sys.argv[1:]
+    result = subprocess.run([compiler, "--version"], stdout=subprocess.PIPE)
+    Path(output).write_bytes(result.stdout)
+    if result.returncode:
+        return 1
+
+    versions = result.stdout.splitlines()
+    if any(line.endswith(b"-dev") for line in versions):
+        print("WARNING: Detected a development version of protoc. "
+              "Development versions are not validated for authenticity. "
+              "To ensure a secure build, please use a released version of protoc.")
+        return 0
+    if any(line.startswith(("libprotoc " + expected).encode()) for line in versions):
+        return 0
+
+    print(f"{severity.upper()}: protoc version does not match protobuf Bazel module; "
+          "we do not support this. It is considered undefined behavior that is "
+          "expected to break in the future even if it appears to work today.",
+          file=sys.stderr)
+    if severity == "error":
+        print("To suppress this error, run Bazel with "
+              "--@com_google_protobuf//bazel/toolchains:allow_nonstandard_protoc",
+              file=sys.stderr)
+    print(f"Expected: libprotoc {expected}", file=sys.stderr)
+    print("Actual:   " + result.stdout.decode(errors="replace").rstrip(), file=sys.stderr)
+    return int(severity == "error")
+
+
+if __name__ == "__main__":
+    sys.exit(main())
