# Hey v0.1.5 ignores response-body read failures and discards remainder requests.
# Retain actual consumed bytes, read errors, and the complete request count.
# Remove this patch when the pinned upstream release includes the corrections.

diff --git a/requester/requester.go b/requester/requester.go
--- a/requester/requester.go
+++ b/requester/requester.go
@@ -183,9 +183,8 @@
 	req = req.WithContext(httptrace.WithClientTrace(req.Context(), trace))
 	resp, err := c.Do(req)
 	if err == nil {
-		size = resp.ContentLength
 		code = resp.StatusCode
-		io.Copy(io.Discard, resp.Body)
+		size, err = io.Copy(io.Discard, resp.Body)
 		resp.Body.Close()
 	}
 	t := now()
@@ -253,12 +252,15 @@
 	}
 	client := &http.Client{Transport: tr, Timeout: time.Duration(b.Timeout) * time.Second}
 
-	// Ignore the case where b.N % b.C != 0.
 	for i := 0; i < b.C; i++ {
-		go func() {
-			b.runWorker(client, b.N/b.C)
+		n := b.N / b.C
+		if i < b.N%b.C {
+			n++
+		}
+		go func(n int) {
+			b.runWorker(client, n)
 			wg.Done()
-		}()
+		}(n)
 	}
 	wg.Wait()
 }
