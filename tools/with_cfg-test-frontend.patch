# Allow a test variant to configure its actual TestRunner through an incoming
# transition while reusing with_cfg's argument, runfiles and provider forwarding.
# Based on with_cfg.bzl v1.0.0. Its frontend and builder are unchanged on
# upstream main a33b1b2d2fd38f5884643d37d1c54c5d280d583c. Neither exposes a
# public frontend override; the released wrapper transitions only its inputs.
# Remove this patch when with_cfg exposes an equivalent public frontend API.
diff --git a/with_cfg.bzl b/with_cfg.bzl
--- a/with_cfg.bzl
+++ b/with_cfg.bzl
@@ -1,4 +1,5 @@
-load("//with_cfg:defs.bzl", _original_settings = "original_settings", _with_cfg = "with_cfg")
+load("//with_cfg:defs.bzl", _original_settings = "original_settings", _frontend_test = "frontend_test", _with_cfg = "with_cfg")
 
 with_cfg = _with_cfg
 original_settings = _original_settings
+frontend_test = _frontend_test
diff --git a/with_cfg/defs.bzl b/with_cfg/defs.bzl
--- a/with_cfg/defs.bzl
+++ b/with_cfg/defs.bzl
@@ -1,3 +1,4 @@
+load("//with_cfg/private:frontend.bzl", _frontend_test = "frontend_test")
 load("//with_cfg/private:original_settings.bzl", _original_settings = "original_settings")
 load("//with_cfg/private:with_cfg.bzl", _with_cfg = "with_cfg")
 
@@ -5,3 +6,4 @@
 
 with_cfg = _with_cfg
 original_settings = _original_settings
+frontend_test = _frontend_test
diff --git a/with_cfg/private/frontend.bzl b/with_cfg/private/frontend.bzl
--- a/with_cfg/private/frontend.bzl
+++ b/with_cfg/private/frontend.bzl
@@ -1,7 +1,7 @@
 load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
 load(":providers.bzl", "FrontendInfo")
 
-visibility("private")
+visibility("//with_cfg/...")
 
 def get_frontend(*, executable, test):
