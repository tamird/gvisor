index b3f76a5..d76a224 100644
--- a/toolchain/args/linux/BUILD.bazel
+++ b/toolchain/args/linux/BUILD.bazel
@@ -1,4 +1,5 @@
 load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
+load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")
 
 package(default_visibility = ["//visibility:public"])
 
@@ -106,30 +107,35 @@ cc_args(
 )
 
 cc_args(
-    name = "default_libs_gnu",
-    actions = [
-        "@rules_cc//cc/toolchains/actions:link_actions",
-    ],
-    args = [
-        # We need to support copts like -lc -ldl etc...
-        "-L{libc_library_search_path}",
+    name = "glibc_library_search_path",
+    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
+    args = ["-L{libc_library_search_path}"],
+    data = ["//runtimes/glibc:glibc_library_search_directory"],
+    format = {"libc_library_search_path": "//runtimes/glibc:glibc_library_search_directory"},
+)
 
-        # In prevention of when all of those can be shared libraries.
+# libunwind needs pthread and dl. A target that opts out of the toolchain's
+# C++ runtimes does not link libunwind or need its dependencies.
+cc_args(
+    name = "libunwind_system_libraries",
+    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
+    args = [
         "-Wl,--push-state",
         "-Wl,--as-needed",
-
-        # Since libunwind is linked statically, we need to link pthread as well.
         "-lpthread",
-        # Since libunwind is linked statically, we need to link dl as well.
         "-ldl",
         "-Wl,--pop-state",
     ],
-    data = [
-        "//runtimes/glibc:glibc_library_search_directory",
-    ],
-    format = {
-        "libc_library_search_path": "//runtimes/glibc:glibc_library_search_directory",
-    },
+    # The runtime bootstrap toolchains do not define this feature.
+    requires_any_of = select({
+        "//toolchain:runtimes_all": ["//toolchain/features:static_link_cpp_runtimes"],
+        "//conditions:default": [],
+    }),
+)
+
+cc_args_list(
+    name = "default_libs_gnu",
+    args = [":glibc_library_search_path", ":libunwind_system_libraries"],
 )
 
