# Zero-layer Unix workers have no /tmp. Let the SDK bootstrap and Go builders
# create temporary files beside their declared outputs when TMPDIR is unset.

diff --git a/go/private/rules/binary_wrapper.sh b/go/private/rules/binary_wrapper.sh
--- a/go/private/rules/binary_wrapper.sh
+++ b/go/private/rules/binary_wrapper.sh
@@ -12,6 +12,9 @@
 export HOME="${PWD}/_go_tool_binary-fake-home-${1//\\//_}"
 trap "${GO_BINARY} clean -cache" EXIT
 
+# The Go commands create unique work directories beside these outputs.
+export TMPDIR="${TMPDIR:-$PWD/${1%/*}}"
+
 # We do not use -a here as the cache drastically reduces the time spent
 # on the subsequent go build invocations (roughly 50% faster).
 
diff --git a/go/tools/builders/env.go b/go/tools/builders/env.go
--- a/go/tools/builders/env.go
+++ b/go/tools/builders/env.go
@@ -96,6 +96,19 @@
 	return nil
 }
 
+// useOutputTempDir lets children use the writable output parent even after
+// changing directory. Each tool still creates and cleans its own temporary files.
+func useOutputTempDir(dir string) error {
+	if runtime.GOOS == "windows" || os.Getenv("TMPDIR") != "" {
+		return nil
+	}
+	path, err := filepath.Abs(dir)
+	if err != nil {
+		return err
+	}
+	return os.Setenv("TMPDIR", path)
+}
+
 // workDir returns a path to a temporary work directory. The same directory
 // is returned on multiple calls. The caller is responsible for cleaning
 // up the work directory by calling cleanup.
