+// useOutputTempDir lets Go and its child processes create temporary files
+// beside declared outputs when no Unix temporary directory was configured.
+// Use an absolute path since children may change working directory.
+func useOutputTempDir(dir string) error {
+	if runtime.GOOS == "windows" || os.Getenv("TMPDIR") != "" {
+		return nil
+	}
+	return os.Setenv("TMPDIR", abs(dir))
+}
+
 // workDir returns a path to a temporary work directory. The same directory
 // is returned on multiple calls. The caller is responsible for cleaning
 // up the work directory by calling cleanup.
