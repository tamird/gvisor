+// A benchmark result closes its own XML case and its parents, without hiding
+// interrupted siblings, explicit failures, or ordinary unfinished tests.
+func TestBenchmarkResults(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		row          string
+		prefix       []jsonEvent
+		tail         []jsonEvent
+		wantErrors   int
+		wantFailures int
+	}{
+		{name: "result", row: "BenchmarkParent/leaf 1 7090 ns/op 15 wire-B/op\n"},
+		{name: "cpu-suffix", row: "BenchmarkParent/leaf-4 1 7090 ns/op\n"},
+		{name: "split-result", row: "1 7090 ns/op\n",
+			prefix: []jsonEvent{{Action: "output", Test: "BenchmarkParent/leaf", Output: "BenchmarkParent/leaf\t"}}},
+		{name: "header", row: "BenchmarkParent/leaf\n", wantErrors: 2},
+		{name: "zero", row: "BenchmarkParent/leaf 0 7090 ns/op\n", wantErrors: 2},
+		{name: "other-name", row: "BenchmarkOther 1 7090 ns/op\n", wantErrors: 2},
+		{name: "invalid-metric", row: "BenchmarkParent/leaf 1 invalid ns/op\n", wantErrors: 2},
+		{name: "failure-before-result", row: "BenchmarkParent/leaf 1 7090 ns/op\n",
+			prefix: []jsonEvent{{Action: "fail", Test: "BenchmarkParent/leaf"}}, wantFailures: 1},
+		{name: "failed-repetition", row: "BenchmarkParent/leaf 1 7090 ns/op\n",
+			prefix: []jsonEvent{{Action: "fail", Test: "BenchmarkParent/leaf"}, {Action: "run", Test: "BenchmarkParent/leaf"}}, wantFailures: 1},
+		{name: "failure-after-result", row: "BenchmarkParent/leaf 1 7090 ns/op\n",
+			tail: []jsonEvent{{Action: "fail", Test: "BenchmarkParent/leaf"}}, wantFailures: 1},
+		{name: "interrupted-sibling", row: "BenchmarkParent/leaf 1 7090 ns/op\n",
+			tail: []jsonEvent{{Action: "run", Test: "BenchmarkParent/interrupted"}}, wantErrors: 1},
+		{name: "interrupted-repeat", row: "BenchmarkParent/leaf 1 7090 ns/op\n",
+			tail: []jsonEvent{{Action: "run", Test: "BenchmarkParent/leaf"}}, wantErrors: 1},
+		{name: "ordinary-test", row: "BenchmarkParent/leaf 1 7090 ns/op\n",
+			tail: []jsonEvent{{Action: "run", Test: "TestUnfinished"}}, wantErrors: 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var input bytes.Buffer
+			enc := json.NewEncoder(&input)
+			events := []jsonEvent{
+				{Action: "run", Test: "BenchmarkParent"},
+				{Action: "run", Test: "BenchmarkParent/leaf"},
+			}
+			events = append(events, tc.prefix...)
+			events = append(events, jsonEvent{Action: "output", Test: "BenchmarkParent/leaf", Output: tc.row})
+			for _, event := range append(events, tc.tail...) {
+				if err := enc.Encode(event); err != nil {
+					t.Fatal(err)
+				}
+			}
+			output, err := json2xml(&input, "benchmark")
+			if err != nil {
+				t.Fatal(err)
+			}
+			var result xmlTestSuites
+			if err := xml.Unmarshal(output, &result); err != nil {
+				t.Fatal(err)
+			}
+			var errors, failures int
+			for _, suite := range result.Suites {
+				errors += suite.Errors
+				failures += suite.Failures
+			}
+			if errors != tc.wantErrors || failures != tc.wantFailures {
+				t.Fatalf("errors/failures = %d/%d, want %d/%d; XML: %s", errors, failures, tc.wantErrors, tc.wantFailures, output)
+			}
+		})
+	}
+}
