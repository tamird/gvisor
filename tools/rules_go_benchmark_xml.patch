+// benchmarkResult recognizes the measurement row for the current benchmark.
+// Ordinary output, benchmark headers, and zero-iteration rows are not results.
+func benchmarkResult(name, line string) bool {
+	fields := strings.Fields(line)
+	if len(fields) < 4 || len(fields)%2 != 0 {
+		return false
+	}
+	if fields[0] != name {
+		cpu, ok := strings.CutPrefix(fields[0], name+"-")
+		if !ok {
+			return false
+		}
+		if n, err := strconv.ParseUint(cpu, 10, 64); err != nil || n == 0 {
+			return false
+		}
+	}
+	if n, err := strconv.ParseUint(fields[1], 10, 64); err != nil || n == 0 {
+		return false
+	}
+	for i := 2; i < len(fields); i += 2 {
+		if _, err := strconv.ParseFloat(fields[i], 64); err != nil {
+			return false
+		}
+	}
+	return true
 }
 
