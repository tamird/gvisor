### Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(python_version = "3.11")

### Release repository test tools
# Keep all package resolution at an immutable snapshot. No package installation
# or network access is required while the release scripts run.
release_apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
release_apt.sources_list(
    architectures = ["amd64"],
    components = [
        "main",
        "universe",
    ],
    suites = [
        "jammy",
        "jammy-updates",
        "jammy-security",
    ],
    types = ["deb"],
    uris = ["https://snapshot.ubuntu.com/ubuntu/20260928T000000Z"],
)
release_apt.install(
    dependency_set = "release_tools",
    packages = [
        "apt-utils",
        "bash",
        "bzip2",
        "coreutils",
        "diffutils",
        "dpkg",
        "dpkg-sig",
        "file",
        "gnupg",
        "grep",
        "gzip",
        "mawk",
        "tar",
        "xz-utils",
        "zstd",
    ],
    suites = [
        "jammy",
        "jammy-updates",
        "jammy-security",
    ],
)
use_repo(release_apt, "release_tools")

