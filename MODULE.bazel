single_version_override(
    module_name = "rules_go",
    patch_strip = 1,
    patches = [
        "//tools:rules_go_symbols.patch",
        "//tools:rules_cgo.patch",
        "//tools:rules_go_export.patch",
    ],
    version = "0.62.0",
)

archive_override(
    module_name = "grpc",
    integrity = "sha256-MdbAHDv6CjWEUyZlcV5IdwPrENdrswtIdeV9E5wTu/k=",
    patch_args = ["-p1"],
    patches = ["//tools:grpc_extra_deps.patch"],
    strip_prefix = "grpc-1.75.0",
    url = "https://github.com/grpc/grpc/archive/refs/tags/v1.75.0.tar.gz",
)

### LLVM
# TODO: try using "llvm-raw" from BCR
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "llvm-raw",
    build_file_content = "# empty",
    sha256 = "c98bbef08a2b4c2613cd50e9aa9ae7b69b1fe6c16b2c40373bc0ab6116fdf78a",
    strip_prefix = "llvm-project-23.1.2.src",
    urls = ["https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/llvm-project-23.1.2.src.tar.xz"],
)

llvm_configure = use_repo_rule("@llvm-raw//utils/bazel:configure.bzl", "llvm_configure")

llvm_configure(name = "llvm-project")

http_archive(
    name = "kythe_release",
    sha256 = "52a9c6e8111237043b8d0b6127637f0eb8d2ba3a776e4749b036e911ec3529ce",
    strip_prefix = "kythe-v0.0.74",
    urls = [
        "https://github.com/kythe/kythe/releases/download/v0.0.74/kythe-v0.0.74.tar.gz",
    ],
)

### Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(python_version = "3.11")

