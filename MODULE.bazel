    module_name = "rules_go",
    patch_strip = 1,
    patches = [
        "//tools:rules_go_symbols.patch",
        "//tools:rules_cgo.patch",
        "//tools:rules_go_export.patch",
    ],
    version = "0.62.0",
)

# Temporary upstream candidate; remove when hermetic-llvm releases header defaults.
single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = ["//tools:llvm-linux-header-default.patch"],
)

archive_override(
    module_name = "grpc",
    integrity = "sha256-MdbAHDv6CjWEUyZlcV5IdwPrENdrswtIdeV9E5wTu/k=",
    patch_args = ["-p1"],
    patches = ["//tools:grpc_extra_deps.patch"],
    strip_prefix = "grpc-1.75.0",
    url = "https://github.com/grpc/grpc/archive/refs/tags/v1.75.0.tar.gz",
)

# Backport google/benchmark@82a895089 until a release includes it.
single_version_override(
    module_name = "google_benchmark",
    patch_strip = 1,
    patches = ["//tools:benchmark-thread-safety.patch"],
)

# Backport abseil/abseil-cpp@0784689a6 without changing the dependency graph.
# Remove when the dependency graph can use a release containing this fix.
single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = ["//tools:abseil-lifetime-attributes.patch"],
)

