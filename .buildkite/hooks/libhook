kill_agent() {
  echo "$1; node is bad." >&2
  echo "Automated monitoring should recycle this node soon." >&2
  echo "If this made your build pipeline fail, sorry!" >&2
  echo "Try your luck again." >&2
  sleep 10
  killall buildkite-agent
  exit 1
}

clear_docker_containers() { # $1: "kill_agent" to kill the agent on failure
  local on_fail="${1:-}" id rc
  # Kill any running containers (clear state), except for "bootstrap".
  for id_and_name in $(docker ps --format='{{.ID}}/{{.Names}}'); do
    if [[ "$(echo "$id_and_name" | cut -d'/' -f2-)" == 'bootstrap' ]]; then
      continue
    fi
    id="$(echo "$id_and_name" | cut -d'/' -f1)"
    rc=0
    timeout --kill-after=10s --preserve-status 30s \
      docker container kill "$id" || rc=$?
    if [[ "${rc}" -ne 0 ]]; then
      if [[ "${on_fail}" == 'kill_agent' ]]; then
        kill_agent "Docker container kill failed for ${id} (exit ${rc})"
      else
        echo "WARN: docker container kill failed for ${id} (exit ${rc})" >&2
      fi
    fi
  done
}

is_remote_source_step() {
  [[ "${BUILDKITE_STEP_KEY:-}" == rbe-source ]]
}

record_job_completion() {
  local count CONSECUTIVE_FAILURES_FILE JOB_ASSIGNED_FILE LAST_JOB_COMPLETED_FILE
  # Track consecutive failures.
  CONSECUTIVE_FAILURES_FILE="/tmp/consecutive_failures"
  if test "${BUILDKITE_COMMAND_EXIT_STATUS}" -ne "0"; then
    count="$(cat "${CONSECUTIVE_FAILURES_FILE}" 2>/dev/null || echo 0)"
    echo "$((count + 1))" > "${CONSECUTIVE_FAILURES_FILE}.tmp"
    mv "${CONSECUTIVE_FAILURES_FILE}.tmp" "${CONSECUTIVE_FAILURES_FILE}"
  else
    rm -f "${CONSECUTIVE_FAILURES_FILE}"
  fi

  # Track last job completed time and job assignment.
  JOB_ASSIGNED_FILE="/tmp/job_assigned"
  touch "${JOB_ASSIGNED_FILE}"
  LAST_JOB_COMPLETED_FILE="/tmp/last_job_completed_time"
  date +%s > "${LAST_JOB_COMPLETED_FILE}.tmp"
  mv "${LAST_JOB_COMPLETED_FILE}.tmp" "${LAST_JOB_COMPLETED_FILE}"
}
