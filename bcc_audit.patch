--- /dev/null
+++ b/bcc/bazel_info_test_helper.cpp
@@ -0,0 +1,17 @@
+#include <algorithm>
+#include <iostream>
+#include <string>
+#include <string_view>
+
+int
+main(int argc, char** argv)
+{
+  // Each block exceeds ordinary pipe capacity. Diagnostics can precede the
+  // location (startup) or follow it (shutdown), including on failed commands.
+  auto const noise = std::string(2 * 1024 * 1024, 'x');
+  std::cerr << "bazel-info-before\n" << noise << '\n';
+  std::cout << "/" << argv[argc - 1] << std::endl;
+  std::cerr << noise << "\nbazel-info-after\n";
+  std::cout << noise << std::endl;
+  return std::find(argv + 1, argv + argc, std::string_view("--fail")) != argv + argc ? 7 : 0;
+}
--- /dev/null
+++ b/bcc/bazel_test.cpp
@@ -0,0 +1,61 @@
+#include <cstdlib>
+#include <filesystem>
+#include <memory>
+#include <stdexcept>
+#include <string>
+
+#include <gtest/gtest.h>
+
+#include "bcc/bazel.hpp"
+#include "tools/cpp/runfiles/runfiles.h"
+
+namespace {
+
+std::string
+helper_path()
+{
+  std::string error;
+  std::unique_ptr<bazel::tools::cpp::runfiles::Runfiles> runfiles(
+    bazel::tools::cpp::runfiles::Runfiles::CreateForTest(BAZEL_CURRENT_REPOSITORY, &error));
+  if (!runfiles) {
+    throw std::runtime_error(error);
+  }
+  auto path = runfiles->Rlocation("bazel-compile-commands/bcc/bazel_info_test_helper");
+#ifdef _WIN32
+  path += ".exe";
+#endif
+  return path;
+}
+
+TEST(bazel, verbose_info)
+{
+  auto const helper = helper_path();
+  ASSERT_TRUE(std::filesystem::exists(helper)) << helper;
+  // The subprocess captures inherited diagnostics without filling another pipe.
+  EXPECT_EXIT(
+    {
+      auto const bazel = bcc::bazel::create(helper, {}, {});
+      std::exit(bazel.workspace_path() == "/workspace" && bazel.execution_root() == "/execution_root" ? 0 : 2);
+    },
+    testing::ExitedWithCode(0),
+    "bazel-info-after");
+}
+
+TEST(bazel, verbose_info_failure)
+{
+  auto const helper = helper_path();
+  ASSERT_TRUE(std::filesystem::exists(helper)) << helper;
+  EXPECT_EXIT(
+    {
+      try {
+        bcc::bazel::create(helper, { "--fail" }, {});
+      } catch (bcc::bazel_error const& error) {
+        std::exit(std::string(error.what()).find("exit code 7") != std::string::npos ? 7 : 2);
+      }
+      std::exit(3);
+    },
+    testing::ExitedWithCode(7),
+    "bazel-info-after");
+}
+
+} // namespace
