# Start with upstream allnoconfig; enable the commands used by the test images.
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_BASENAME=y
CONFIG_CAT=y
CONFIG_CUT=y
CONFIG_DD=y
CONFIG_DF=y
CONFIG_DIRNAME=y
CONFIG_GREP=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
# fsstress removes each worker's files through the shell after a run.
CONFIG_RM=y
CONFIG_SED=y
CONFIG_SETSID=y
CONFIG_SLEEP=y
# The syscall benchmarks keep their containers alive with sleep 24h.
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_SORT=y
CONFIG_STAT=y
# The emptyDir test checks the final size after exhausting its tmpfs quota.
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_TEE=y
CONFIG_TR=y
CONFIG_FEATURE_TR_CLASSES=y
CONFIG_TRUE=y
CONFIG_UNIQ=y
CONFIG_WC=y
# HTTP readiness probes use wget --spider to check the server without a download.
CONFIG_WGET=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
