# Start with upstream allnoconfig; enable the commands used by the test images.
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_SH_IS_ASH=y
CONFIG_ASH_ECHO=y
CONFIG_CAT=y
CONFIG_DD=y
CONFIG_DF=y
CONFIG_GREP=y
CONFIG_READLINK=y
# fsstress removes each worker's files through the shell after a run.
CONFIG_RM=y
CONFIG_SETSID=y
CONFIG_SLEEP=y
# The syscall benchmarks keep their containers alive with sleep 24h.
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_STAT=y
# The emptyDir test checks the final size after exhausting its tmpfs quota.
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_TRUE=y
