Run Nginx configure probes with the declared target emulator when needed.

The upstream configure script executes test binaries and assumes i386 for
--crossbuild. Preserve the target compiler's actual probe results and select
the target OS and machine explicitly instead of inheriting the execution CPU.
Probe execution remains native when no runner is supplied.
Honor the linker environment without embedding temporary toolchain paths
in nginx -V configure metadata. Fixed target and runtime options remain.
Remove this patch when upstream exposes equivalent cross-probe support.

Upstream: https://github.com/nginx/nginx/blob/release-1.31.7/auto/feature
Upstream: https://github.com/nginx/nginx/blob/release-1.31.7/configure

diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -44,7 +44,7 @@
 else
     echo "building for $NGX_PLATFORM"
-    NGX_SYSTEM=$NGX_PLATFORM
-    NGX_MACHINE=i386
+    NGX_SYSTEM=${NGX_PLATFORM%%:*}
+    NGX_MACHINE=${NGX_TARGET_MACHINE:-i386}
 fi
 
 . auto/cc/conf
diff --git a/auto/init b/auto/init
--- a/auto/init
+++ b/auto/init
@@ -51,3 +51,13 @@
 
 .PHONY:	default clean
 END
+
+# A cross build can supply a runner for target-architecture configure probes.
+# Keep a child shell so signals do not print diagnostics in the parent shell.
+ngx_run_test() {
+    if test -n "$NGX_TEST_RUNNER"; then
+        /bin/sh -c '"$@"' -- "$NGX_TEST_RUNNER" "$@"
+    else
+        /bin/sh -c '"$@"' -- "$@"
+    fi
+}
diff --git a/auto/feature b/auto/feature
--- a/auto/feature
+++ b/auto/feature
@@ -52,8 +52,8 @@
     case "$ngx_feature_run" in
 
         yes)
-            # /bin/sh is used to intercept "Killed" or "Abort trap" messages
-            if /bin/sh -c $NGX_AUTOTEST >> $NGX_AUTOCONF_ERR 2>&1; then
+            # The runner also intercepts "Killed" or "Abort trap" messages
+            if ngx_run_test "$NGX_AUTOTEST" >> $NGX_AUTOCONF_ERR 2>&1; then
                 echo " found"
                 ngx_found=yes
 
@@ -67,15 +67,15 @@
         ;;
 
         value)
-            # /bin/sh is used to intercept "Killed" or "Abort trap" messages
-            if /bin/sh -c $NGX_AUTOTEST >> $NGX_AUTOCONF_ERR 2>&1; then
+            # The runner also intercepts "Killed" or "Abort trap" messages
+            if ngx_run_test "$NGX_AUTOTEST" >> $NGX_AUTOCONF_ERR 2>&1; then
                 echo " found"
                 ngx_found=yes
 
                 cat << END >> $NGX_AUTO_CONFIG_H
 
 #ifndef $ngx_feature_name
-#define $ngx_feature_name  `$NGX_AUTOTEST`
+#define $ngx_feature_name  `ngx_run_test "$NGX_AUTOTEST"`
 #endif
 
 END
@@ -85,8 +85,8 @@
         ;;
 
         bug)
-            # /bin/sh is used to intercept "Killed" or "Abort trap" messages
-            if /bin/sh -c $NGX_AUTOTEST >> $NGX_AUTOCONF_ERR 2>&1; then
+            # The runner also intercepts "Killed" or "Abort trap" messages
+            if ngx_run_test "$NGX_AUTOTEST" >> $NGX_AUTOCONF_ERR 2>&1; then
                 echo " not found"
 
             else
