set -eu
src=$(cd "$(dirname "$0")" && pwd)
version=$(cat "$src/bazelversion")
arch=$(uname -m)
case "$arch" in
  x86_64) ;;
  aarch64) arch=arm64 ;;
  *) echo "No Linux Bazel binary configured for $arch" >&2; exit 1 ;;
esac

asset="bazel-$version-linux-$arch"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 "https://releases.bazel.build/$version/release/$asset" -o "$tmp/$asset"
(cd "$tmp" && sha256sum --check --strict --ignore-missing "$src/bazel.sha256")
install -m 0755 "$tmp/$asset" "$1/bazel"
