FROM ubuntu:jammy

RUN apt-get update && apt-get install -y \
  autoconf \
  build-essential \
  ca-certificates-java \
  curl \
  java-common \
  make \
  openjdk-21-jdk \
  unzip \
  zip

# Match the JDK tests to the installed package, including security updates.
# Proctor reads these tests from /opt/jdk.
WORKDIR /opt
RUN set -ex \
 && jdk_package_version="$(dpkg-query --show --showformat='${Version}' openjdk-21-jdk)" \
 && apt-get install -y "openjdk-21-source=${jdk_package_version}" "openjdk-21-testsupport=${jdk_package_version}" \
 && test "$(dpkg-query --show --showformat='${Version}' openjdk-21-source)" = "$jdk_package_version" \
 && test "$(dpkg-query --show --showformat='${Version}' openjdk-21-testsupport)" = "$jdk_package_version" \
 && java_home="$(dirname "$(dirname "$(readlink -f /usr/bin/java)")")" \
 && test -r "$java_home/lib/src.zip" \
 && ln -s "$java_home/testsuite/jdk/jtreg/native" /opt/jdk-native \
 && test -r /opt/jdk-native/libCreationTimeHelper.so \
 && jdk_version="$(dpkg-query --show --showformat='${source:Upstream-Version}' openjdk-21-jdk)" \
 && test -n "$jdk_version" \
 && curl -fsSL --retry 10 -o /tmp/jdk.tar.gz "https://github.com/openjdk/jdk21u/archive/refs/tags/jdk-${jdk_version}.tar.gz" \
 && mkdir /opt/jdk \
 && tar -zxzf /tmp/jdk.tar.gz --strip-components=1 -C /opt/jdk \
 && rm -f /tmp/jdk.tar.gz

# Install jtreg 7.5.2+1, the minimum required by the matching JDK tests.
#
# NOTE: While upgrading jdk version, if this jtreg version does not build
# openjdk correctly, try using a recent version of jtreg that does work.
#
# ALSO NOTE: The installed location of the JDK is annoyingly path dependant,
# and is "/usr/lib/jvm/java-21-openjdk-amd64" on x86_64 but "-aarch64" on
# ARM64. The `build.sh` step below uses a wildcard to work around the fact that
# we don't know the full path.
ARG COMMIT=05c67a77fa8ae98cacbba0f8012df8bdf04105a7
RUN set -ex \
 && curl -fsSL --retry 10 -o jtreg.tar.gz https://github.com/openjdk/jtreg/archive/${COMMIT}.tar.gz \
 && tar -zxvf jtreg.tar.gz \
 && mv jtreg-${COMMIT} jtreg \
 && bash jtreg/make/build.sh --jdk /usr/lib/jvm/java-21-openjdk-* \
 && rm -f jtreg.tar.gz

# The jtreg launcher checks this path before executing Java.
ENV JTREG_JAVA=/usr/bin/java
ENV PATH="/opt/jtreg/build/images/jtreg/bin:$PATH"

# Permission-sensitive JDK tests require an ordinary user and writable cwd.
RUN useradd --create-home --uid 1000 --user-group java
ENV HOME=/home/java
USER java
WORKDIR /home/java
