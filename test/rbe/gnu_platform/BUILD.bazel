# Fork qualification only. The estimate sizes remote build actions, not the
# coordinator. Heavier jobs can inherit this platform and override the estimate.
platform(
    name = "gnu",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "Arch": "amd64",
        "EstimatedMemory": "2GB",
        "OSFamily": "linux",
        "container-image": "docker://gcr.io/gvisor-presubmit/default_x86_64@sha256:cff9bcf01c7a23182b2bb44520cfeb3375b6b138ddca3ab2e121bc54015e754a",
        "workload-isolation-type": "firecracker",
    },
    visibility = ["//visibility:public"],
)
