diff --git a/go/private/rules/sdk.bzl b/go/private/rules/sdk.bzl
index 5c6617624dc117abc70d895cda261bf7ac417aba..c8b3f6dc545a961fbaafb214b496858e289b5f60 100644
--- a/go/private/rules/sdk.bzl
+++ b/go/private/rules/sdk.bzl
@@ -12,6 +12,7 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 
+load("//go/private:common.bzl", "GO_TOOLCHAIN_LABEL", "SUPPORTS_PATH_MAPPING_REQUIREMENT")
 load(
     "//go/private:providers.bzl",
     "GoSDK",
@@ -119,6 +120,60 @@ go_sdk = rule(
     provides = [GoSDK],
 )
 
+def _dirname(file):
+    return file.dirname
+
+def _go_sdk_tool_impl(ctx):
+    toolchain = ctx.toolchains[GO_TOOLCHAIN_LABEL]
+    sdk = toolchain.sdk
+    name = ctx.attr.tool
+    if not name or "/" in name or "\\" in name or name in [".", ".."]:
+        fail("tool must be a command name in the Go SDK")
+    suffix = ".exe" if toolchain.default_goos == "windows" else ""
+    out = ctx.actions.declare_file(ctx.label.name + suffix)
+    if (toolchain.default_goos, toolchain.default_goarch) == (sdk.goos, sdk.goarch):
+        path = "%s/pkg/tool/%s_%s/%s%s" % (sdk.root_file.dirname, sdk.goos, sdk.goarch, name, suffix)
+        for tool in sdk.tools.to_list():
+            if tool.path == path:
+                ctx.actions.symlink(output = out, target_file = tool, is_executable = True)
+                return [DefaultInfo(executable = out)]
+
+    args = ctx.actions.args()
+    args.add("sdktool")
+    args.add_all("-sdk", [sdk.root_file], map_each = _dirname, expand_directories = False)
+    args.add("-out", out)
+    args.add(name)
+    ctx.actions.run(
+        executable = toolchain._builder,
+        arguments = [args],
+        inputs = depset([sdk.go, sdk.root_file], transitive = [sdk.headers, sdk.srcs, sdk.tools, sdk.libs]),
+        outputs = [out],
+        env = {
+            "CGO_ENABLED": "0",
+            "GO111MODULE": "off",
+            "GOARCH": toolchain.default_goarch,
+            "GOENV": "off",
+            "GOEXPERIMENT": sdk.experiments,
+            "GOOS": toolchain.default_goos,
+            "GOTELEMETRY": "off",
+            "GOTOOLCHAIN": "local",
+        },
+        mnemonic = "GoSDKTool",
+        toolchain = GO_TOOLCHAIN_LABEL,
+        execution_requirements = SUPPORTS_PATH_MAPPING_REQUIREMENT,
+    )
+    return [DefaultInfo(executable = out)]
+
+go_sdk_tool = rule(
+    _go_sdk_tool_impl,
+    doc = "Provides a Go SDK command as an executable. Use it in the exec configuration to run it in a build action.",
+    attrs = {
+        "tool": attr.string(mandatory = True, doc = "Command name under the Go SDK's cmd directory, such as objdump."),
+    },
+    executable = True,
+    toolchains = [GO_TOOLCHAIN_LABEL],
+)
+
 def _package_list_impl(ctx):
     _build_package_list(ctx, ctx.files.srcs, ctx.file.root_file, ctx.outputs.out)
     return [DefaultInfo(files = depset([ctx.outputs.out]))]
diff --git a/go/toolchains.rst b/go/toolchains.rst
index 1d795e0f4ebc3b66390c4bb13bd021d7678f8680..d3349db3eefd7123a2b8fbbaf3a9fd3c0e5ea5fb 100644
--- a/go/toolchains.rst
+++ b/go/toolchains.rst
@@ -272,6 +272,22 @@ Bzlmod equivalent:
 The SDK will use the bootstrapped compiler/linker binaries directly.
 
 
+Using SDK tools in build actions
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+Use an executable target for a Go SDK tool that an action needs:
+
+.. code:: bzl
+
+    load("@io_bazel_rules_go//go:def.bzl", "go_sdk_tool")
+
+    go_sdk_tool(name = "objdump", tool = "objdump")
+
+Declare the consumer's tool attribute with ``cfg = "exec"`` so it runs on
+the execution platform even when inspecting a file built for another
+platform. The rule reuses a matching executable in the SDK's ``pkg/tool``
+directory, or builds the command from the selected SDK in a separate action.
+
 Writing new Go rules
 ~~~~~~~~~~~~~~~~~~~~
 
