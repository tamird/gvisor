+def run_wrapped(ctx, wrapped, **kwargs):
+    """Run the generated wrapper on the foreign build's execution platform.
+
+    Args:
+        ctx: Rule context.
+        wrapped: Output of wrap_outputs.
+        **kwargs: Other arguments to the Bazel action.
+    """
+    if wrapped.bash:
+        ctx.actions.run(
+            executable = wrapped.bash,
+            arguments = [wrapped.wrapper_script_file.path],
+            exec_group = FOREIGN_CC_EXEC_GROUP,
+            **kwargs
+        )
+    else:
+        # Preserve Bazel's shell setup, notably on Windows.
+        ctx.actions.run_shell(
+            command = wrapped.wrapper_script_file.path,
+            exec_group = FOREIGN_CC_EXEC_GROUP,
+            **kwargs
+        )
