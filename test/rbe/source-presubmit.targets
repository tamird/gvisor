# Cgroup-v2 unit tests and their build-only inputs.
//:all
//pkg/...
//tools/...
//runsc/...
//vdso/...
//sandboxexec/...
//examples/...
//test/trace/...

# Native Linux syscall tests on workers that support nested namespaces.
//test/rbe:native_syscalls

# ARM64 syscall tests running under runsc with ptrace or systrap.
