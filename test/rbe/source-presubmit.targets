//test/rtnetlink:arm64_syscalls

# Standalone syscall binaries built by the mixed profile.
//test/syscalls:arm64_standalone_fixtures

# PacketImpact needs nested namespaces on its native test worker.
//test/packetimpact/tests:mixed_tests
