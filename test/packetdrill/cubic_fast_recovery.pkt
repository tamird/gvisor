// CUBIC must retransmit a dropped segment after three duplicate ACKs and
// resume sending after recovery. Check actual packets, not private counters.

0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0 setsockopt(3, SOL_TCP, TCP_CONGESTION, "cubic", 5) = 0
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0

// Do not negotiate SACK or timestamps. This tests duplicate-ACK/RTO recovery
// without depending on either stack's RACK/TLP configuration.
+0 < S 0:0(0) win 50000 <mss 1000>
+0 > S. 0:0(0) ack 1 <...>
+.1 < . 1:1(0) ack 1 win 50000
+0 accept(3, ..., ...) = 4
+0 getsockopt(4, SOL_TCP, TCP_CONGESTION, "cubic", [5]) = 0
+0 setsockopt(4, SOL_TCP, TCP_NODELAY, [1], 4) = 0

// Acknowledge data before loss so NewReno recovery is eligible.
+0 write(4, ..., 1000) = 1000
+0 > P. 1:1001(1000) ack 1
+.1 < . 1:1(0) ack 1001 win 50000

+0 write(4, ..., 1000) = 1000
+0 > P. 1001:2001(1000) ack 1
+0 write(4, ..., 1000) = 1000
+0 > P. 2001:3001(1000) ack 1
+0 write(4, ..., 1000) = 1000
+0 > P. 3001:4001(1000) ack 1
+0 write(4, ..., 1000) = 1000
+0 > P. 4001:5001(1000) ack 1

// Three duplicate ACKs request fast retransmission of the missing first
// segment; the final cumulative ACK covers the entire original flight.
+.1 < . 1:1(0) ack 1001 win 50000
+.01 < . 1:1(0) ack 1001 win 50000
+.01 < . 1:1(0) ack 1001 win 50000
+0 > P. 1001:2001(1000) ack 1
+.1 < . 1:1(0) ack 5001 win 50000

// A new application write makes forward progress after recovery.
+0 write(4, ..., 1000) = 1000
+0 > P. 5001:6001(1000) ack 1
+.1 < . 1:1(0) ack 6001 win 50000
